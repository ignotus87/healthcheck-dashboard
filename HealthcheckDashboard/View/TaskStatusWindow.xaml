<Window x:Class="HealthcheckDashboard.TaskStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Status Dashboard" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Closed="TaskStatusWindow_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,15,20,10" Orientation="Vertical">
            <TextBlock Text="Task Status Dashboard" FontSize="18" FontWeight="Bold" Foreground="#333"/>
            <TextBlock x:Name="UpdateTimeLabel" Text="Last updated: Never" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid Grid.Row="1" Margin="20,0,20,15"
                  ItemsSource="{Binding Tasks}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  IsReadOnly="True"
                  x:Name="TaskStatusDataGrid"
                  GridLinesVisibility="Horizontal">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Execute now" 
                              Click="ExecuteNow_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Task Name" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Last Run" Binding="{Binding LastRunTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="155"/>
                <DataGridTextColumn Header="Next Run" Binding="{Binding NextRunTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="155"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E8F4F8"/>
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Margin="20,0,20,15" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Padding="15,8"
                    Background="#DC3545" Foreground="White"
                    Click="Button_Click"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>